# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Bot Owner Telegram ID
OWNER_ID=986380678

# Port for Keep-Alive Web Server (Render sets this automatically)
PORT=8080

# Your Render public URL (e.g. https://your-app.onrender.com)
# Leave empty for local testing. On Render, set this to ping itself every 10 min.
PING_URL=
